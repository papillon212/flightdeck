#!/usr/bin/env bash
# Claude Code 세션 안에서 claude를 띄우면 CLAUDECODE·CLAUDE_CODE_* 환경변수가 상속된다.
# 특히 CLAUDE_CODE_CHILD_SESSION=1 이면 대화형 세션이 transcript를 저장하지 않는다.
# 사용자의 일반 터미널과 같은 조건을 만들기 위해 이 변수들을 모두 지우고 실행한다.
unset_args=()
while IFS= read -r name; do
  unset_args+=(-u "$name")
done < <(env | grep -oE '^(CLAUDE[A-Z0-9_]*|CLAUDECODE)=' | sed 's/=$//')
exec env "${unset_args[@]}" claude "$@"
