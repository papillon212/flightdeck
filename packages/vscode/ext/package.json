{
  "name": "flightdeck",
  "displayName": "Flightdeck",
  "description": "코딩 에이전트 시대의 원격 페어 프로그래밍 워크플로우",
  "publisher": "flightdeck",
  "version": "0.1.0",
  "private": true,
  "engines": { "vscode": "^1.90.0" },
  "main": "./dist/extension.cjs",
  "activationEvents": ["onStartupFinished", "onUri"],
  "capabilities": {
    "untrustedWorkspaces": { "supported": false, "description": "Flightdeck은 에이전트 훅과 git을 다루므로 신뢰한 폴더에서만 동작합니다 (설계 §6.1)." }
  },
  "contributes": {
    "commands": [
      { "command": "flightdeck.newEpic", "title": "새 에픽 (내 일감에서 시작)", "category": "Flightdeck" },
      { "command": "flightdeck.inbox", "title": "받은 질문", "category": "Flightdeck" },
      { "command": "flightdeck.login", "title": "서버 로그인", "category": "Flightdeck" },
      { "command": "flightdeck.logout", "title": "서버 로그아웃", "category": "Flightdeck" },
      { "command": "flightdeck.cloneFromServer", "title": "서버 레포 받기", "category": "Flightdeck" },
      { "command": "flightdeck.startMeeting", "title": "회의 시작", "category": "Flightdeck" },
      { "command": "flightdeck.joinMeeting", "title": "회의 참여", "category": "Flightdeck" },
      { "command": "flightdeck.endMeeting", "title": "회의 종료 (주최자)", "category": "Flightdeck" },
      { "command": "flightdeck.collectMeeting", "title": "회의 요약 초안 만들기 (회의록 다시 가져오기)", "category": "Flightdeck" },
      { "command": "flightdeck.publishMeeting", "title": "회의 요약 게시", "category": "Flightdeck" },
      { "command": "flightdeck.watch", "title": "관찰 시작", "category": "Flightdeck" },
      { "command": "flightdeck.sendOpinion", "title": "의견 보내기", "category": "Flightdeck", "icon": "$(comment)" },
      { "command": "flightdeck.requestPilot", "title": "조종 요청", "category": "Flightdeck" },
      { "command": "flightdeck.handOff", "title": "조종 넘기기", "category": "Flightdeck" },
      { "command": "flightdeck.adoptPilot", "title": "넘겨받은 조종 이어서 작업", "category": "Flightdeck" },
      { "command": "flightdeck.takeover", "title": "조종 강제 인수 (조종수 이탈)", "category": "Flightdeck" },
      { "command": "flightdeck.opinion.deliver", "title": "에이전트에 전달", "category": "Flightdeck", "icon": "$(arrow-right)" },
      { "command": "flightdeck.opinion.urgent", "title": "급한 의견으로 전달 (지금 멈춤)", "category": "Flightdeck", "icon": "$(debug-stop)" },
      { "command": "flightdeck.opinion.reply", "title": "답장", "category": "Flightdeck", "icon": "$(reply)" },
      { "command": "flightdeck.opinion.dismiss", "title": "닫기", "category": "Flightdeck", "icon": "$(close)" },
      { "command": "flightdeck.setTrackerToken", "title": "일감 도구(ClickUp) 개인 토큰 설정", "category": "Flightdeck" },
      { "command": "flightdeck.requestReview", "title": "리뷰 요청", "category": "Flightdeck", "enablement": "flightdeck.inEpic" },
      { "command": "flightdeck.approve", "title": "승인", "category": "Flightdeck", "enablement": "flightdeck.inEpic" },
      { "command": "flightdeck.postAllDrafts", "title": "쓰레드 초안 모두 올리기", "category": "Flightdeck", "enablement": "flightdeck.inEpic" },
      { "command": "flightdeck.askAgent", "title": "내 에이전트에게 묻기", "category": "Flightdeck", "icon": "$(comment-discussion)", "enablement": "flightdeck.inEpic" },
      { "command": "flightdeck.postDraft", "title": "올리기", "icon": "$(cloud-upload)" },
      { "command": "flightdeck.discardDraft", "title": "버리기", "icon": "$(trash)" },
      { "command": "flightdeck.draft", "title": "에이전트 초안 작성", "category": "Flightdeck", "enablement": "flightdeck.inEpic" },
      { "command": "flightdeck.resume", "title": "이어서 작업 (Claude Code)", "category": "Flightdeck", "enablement": "flightdeck.inEpic" },
      { "command": "flightdeck.completePhase", "title": "단계 완료 (구현 단계: 구현 완료·제출)", "category": "Flightdeck", "enablement": "flightdeck.inEpic" },
      { "command": "flightdeck.unexplained", "title": "설명 필요 변경 (메모 쓰기)", "category": "Flightdeck", "enablement": "flightdeck.inEpic" },
      { "command": "flightdeck.restoreCheckpoint", "title": "체크포인트로 복원", "category": "Flightdeck", "enablement": "flightdeck.inEpic" },
      { "command": "flightdeck.compareCheckpoint", "title": "체크포인트 비교", "category": "Flightdeck", "enablement": "flightdeck.inEpic" },
      { "command": "flightdeck.applyPatch", "title": "수정 제안 반영", "icon": "$(git-merge)" },
      { "command": "flightdeck.requestVerification", "title": "검증 다시 요청", "category": "Flightdeck", "enablement": "flightdeck.inEpic" },
      { "command": "flightdeck.resumeImplementation", "title": "구현 재개", "category": "Flightdeck", "enablement": "flightdeck.inEpic" },
      { "command": "flightdeck.suggestFix", "title": "수정 제안 만들기 (리뷰 사본)", "category": "Flightdeck", "enablement": "flightdeck.inEpic" },
      { "command": "flightdeck.auditMain", "title": "main 감사", "category": "Flightdeck" },
      { "command": "flightdeck.menu", "title": "메뉴", "category": "Flightdeck" },
      { "command": "flightdeck.refresh", "title": "새로 고침", "category": "Flightdeck" },
      { "command": "flightdeck.reply", "title": "올리기", "enablement": "!commentIsEmpty" },
      { "command": "flightdeck.resolve", "title": "해결", "icon": "$(check)" },
      { "command": "flightdeck.reopen", "title": "다시 열기", "icon": "$(issue-reopened)" }
    ],
    "views": {
      "explorer": [
        { "id": "flightdeck.live", "name": "Flightdeck 실시간 대화" },
        { "id": "flightdeck.opinions", "name": "Flightdeck 의견" }
      ]
    },
    "menus": {
      "view/item/context": [
        { "command": "flightdeck.sendOpinion", "group": "inline", "when": "view == flightdeck.live && viewItem == fd-chat" },
        { "command": "flightdeck.opinion.deliver", "group": "inline@1", "when": "view == flightdeck.opinions && viewItem == fd-opinion-new" },
        { "command": "flightdeck.opinion.urgent", "group": "inline@2", "when": "view == flightdeck.opinions && viewItem == fd-opinion-new" },
        { "command": "flightdeck.opinion.reply", "group": "inline@3", "when": "view == flightdeck.opinions && viewItem == fd-opinion-new" },
        { "command": "flightdeck.opinion.dismiss", "group": "inline@4", "when": "view == flightdeck.opinions && viewItem == fd-opinion-new" }
      ],
      "comments/commentThread/context": [
        { "command": "flightdeck.reply", "group": "inline", "when": "commentController == flightdeck" }
      ],
      "comments/commentThread/title": [
        { "command": "flightdeck.applyPatch", "group": "navigation", "when": "commentController == flightdeck && commentThread == fd-open-patch" },
        { "command": "flightdeck.resolve", "group": "navigation", "when": "commentController == flightdeck && commentThread =~ /^fd-open/" },
        { "command": "flightdeck.reopen", "group": "navigation", "when": "commentController == flightdeck && commentThread == fd-resolved" },
        { "command": "flightdeck.askAgent", "group": "navigation", "when": "commentController == flightdeck && commentThread =~ /^fd-(open|open-patch|resolved)$/" },
        { "command": "flightdeck.postDraft", "group": "navigation", "when": "commentController == flightdeck && commentThread == fd-draft" },
        { "command": "flightdeck.discardDraft", "group": "navigation", "when": "commentController == flightdeck && commentThread =~ /^fd-draft/" }
      ],
      "commandPalette": [
        { "command": "flightdeck.opinion.deliver", "when": "false" },
        { "command": "flightdeck.opinion.urgent", "when": "false" },
        { "command": "flightdeck.opinion.reply", "when": "false" },
        { "command": "flightdeck.opinion.dismiss", "when": "false" },
        { "command": "flightdeck.reply", "when": "false" },
        { "command": "flightdeck.resolve", "when": "false" },
        { "command": "flightdeck.reopen", "when": "false" },
        { "command": "flightdeck.postDraft", "when": "false" },
        { "command": "flightdeck.discardDraft", "when": "false" },
        { "command": "flightdeck.applyPatch", "when": "false" }
      ]
    },
    "configuration": {
      "title": "Flightdeck",
      "properties": {
        "flightdeck.serverUrl": { "type": "string", "default": "", "description": "flightdeck-server 주소 (예: http://127.0.0.1:8787). 비우면 개발 모드(로컬 설정, 서명 없음)" },
        "flightdeck.serverKeyFingerprint": { "type": "string", "default": "", "description": "서버 키 지문 (SHA256:…). 관리자가 배포한다. 설정 응답과 단계 통과 이벤트를 이 키로 검증한다" },
        "flightdeck.product": { "type": "string", "default": "", "description": "이 레포의 제품 ID (서버 어드민의 제품)" },
        "flightdeck.gitRemote": { "type": "string", "default": "origin", "description": "제품 레포의 git 원격 이름" },
        "flightdeck.devLoginMember": { "type": "string", "default": "", "description": "개발용 로그인 멤버 ID. 서버가 개발용 로그인을 켰을 때만 (Google 로그인 대신)" },
        "flightdeck.member": { "type": "string", "default": "", "description": "개발 모드의 멤버 ID (예: dh.lee). 비우면 git user.email의 @ 앞부분. 서버 모드에서는 로그인한 멤버" },
        "flightdeck.configDir": { "type": "string", "default": "", "description": "개발 모드의 설정 폴더 (rules/, pipeline.yaml). 비우면 내장 견본. 서버 모드에서는 서버가 배포한다" },
        "flightdeck.model": { "type": "string", "default": "", "description": "에이전트 권장 모델 (비우면 Claude Code 기본값)" },
        "flightdeck.maxTurns": { "type": "number", "default": 40, "description": "자동 초안의 최대 턴 수" },
        "flightdeck.claudePath": { "type": "string", "default": "claude", "description": "Claude Code 실행 파일" },
        "flightdeck.meet": { "type": "string", "enum": ["google", "gws", "fixture"], "default": "google", "description": "회의 연동: google(OAuth 클라이언트 필요) | gws(개발 모드: gws CLI에 위임) | fixture(개발 모드: 시험용 회의 자료)" },
        "flightdeck.googleClientId": { "type": "string", "default": "", "description": "회의 연동용 Google OAuth 데스크톱 클라이언트 ID (관리자가 배포)" },
        "flightdeck.googleClientSecret": { "type": "string", "default": "", "description": "Google 데스크톱 클라이언트의 secret (데스크톱 앱은 공개 값)" },
        "flightdeck.gwsPath": { "type": "string", "default": "gws", "description": "개발 모드 gws CLI 경로" },
        "flightdeck.meetFixtureDir": { "type": "string", "default": "", "description": "개발 모드 시험용 회의 자료 폴더 (notes.md, transcript.json)" }
      }
    }
  }
}
