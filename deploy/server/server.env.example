# flightdeck-server 설정 (docs/install.md). server.env로 복사해 고친다. 비밀값이 들어가므로 레포에 올리지 않는다.

# 서버 데이터: 서버 서명 키(server-key.pem), 내장 git 레포, 서버 작업 사본. 백업되는 영구 폴더로
FD_DATA_DIR=/srv/flightdeck/data

# PostgreSQL (멤버·설정 버전·세션·편집 기록)
FD_DATABASE_URL=postgres://flightdeck:CHANGE_ME@127.0.0.1:5432/flightdeck

# 루프백에만 연다. 멤버는 SSH 터널로 붙는다(개발용 로그인은 루프백에서만 켜진다)
FD_HOST=127.0.0.1
FD_PORT=8787

# 개발용 로그인: Google OAuth 클라이언트가 생기기 전까지 팀 내부 시험용.
# 터널에 붙은 사람은 아무 멤버로나 로그인할 수 있으므로 신뢰하는 사람에게만 터널을 연다
FD_DEV_LOGIN=1

# 처음 한 번: 어드민이 없으면 만든다 (멤버ID:이메일)
FD_BOOTSTRAP_ADMIN=admin:admin@example.com

# 처음 한 번: 제품 설정 폴더(pipeline.yaml + rules/)를 가져온다. 그 제품의 설정이 없을 때만
FD_IMPORT_PRODUCT=/srv/flightdeck/config/my-product
# 가져올 때 pipeline.yaml의 repo를 바꾼다: builtin(서버 내장 git) 또는 외부 git URL
FD_PRODUCT_REPO=builtin
# 내장 git이고 내장 레포가 아직 없으면 이 레포의 모든 ref를 가져온다 (서버 기기가 이 레포를 읽을 수 있어야 한다)
FD_IMPORT_REPO=git@github.com:my-org/my-product.git

# 반영 대기 스캔 주기 (ms, 기본 60000)
# FD_LAND_SCAN_MS=60000

# Google 로그인 (OAuth 웹 클라이언트를 발급받으면. 그때는 FD_DEV_LOGIN을 끄고 FD_HOST·TLS를 정한다)
# FD_GOOGLE_CLIENT_ID=
# FD_GOOGLE_CLIENT_SECRET=
# FD_PUBLIC_URL=https://flightdeck.example.com

# 백업 (deploy/server/backup.sh)
FD_BACKUP_DIR=/srv/flightdeck/backup
# PostgreSQL이 Docker 컨테이너면 그 이름 (pg_dump를 컨테이너 안에서 실행)
FD_PG_CONTAINER=flightdeck-pg
